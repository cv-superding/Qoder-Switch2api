{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Qoder-Switch2api",
  "version": "1.1.22",
  "identifier": "com.qoder-switch2api.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Qoder-Switch2api",
    "copyright": "Copyright © 2026 Qoder-Switch2api",
    "category": "DeveloperTool",
    "shortDescription": "Qoder 多账号切换与 OpenAI/Anthropic 兼容反代",
    "longDescription": "Qoder 多账号切换、每日自动签到、额度统计与 OpenAI/Anthropic 兼容本地反代。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "startMenuFolder": "Qoder-Switch2api"
      }
    }
  }
}
